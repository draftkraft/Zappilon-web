:false},"seed":{"draw":"sprite","sprite":{"parts":[{"shape":"ellipse","x":8,"y":12,"rx":5,"ry":7,"fill":"#e8d888","stroke":"#b8b050"},{"shape":"line","points":[[13,12],[13,6]],"width":1,"stroke":"#8c7030"},{"shape":"line","points":[[13,6],[16,3]],"width":1,"stroke":"#8c7030"},{"shape":"line","points":[[13,6],[10,3]],"width":1,"stroke":"#8c7030"}]},"color":"#e8d888","box":[6,8,12,16],"name":"Samen","carry":true,"throw":{"arc":"low","speed":6,"onEnemy":"stun","stun":2.5,"breaks":[],"score":100},"effects":{"score":50}}},"i18n":{"Fange 2 Kaktuswustler!":{"en":"Catch 2 Kaktuswustlers!","es":"¡Atrapa 2 Kaktuswustlers!","fr":"Attrapez 2 Kaktuswustlers !","ja":"カクタスウストラーを2匹捕まえよう！","pt":"Capture 2 Kaktuswustlers!","zh":"抓住2只Kaktuswustler！","it":"Cattura 2 Kaktuswustlers!"},"Wirf Samen mit X auf den Mund – dann greif zu!":{"en":"Throw seeds with X into its mouth – then grab it!","es":"¡Lanza semillas con X en su boca – luego atrápala!","fr":"Lance des graines avec X dans sa bouche – puis attrape-la !","ja":"Xで種を口に投げて、捕まえよう！","pt":"Jogue sementes com X na boca dela – depois capture-a!","zh":"用X向它的嘴扔种子——然后抓住它！","it":"Lancia i semi con X nella sua bocca – poi catturala!"},"Vulkan-Gewächshaus":{"en":"Volcano Greenhouse","es":"Invernadero Volcánico","fr":"Serre Volcanique","ja":"火山の温室","pt":"Estufa Vulcânica","zh":"火山温室","it":"Serra Vulkanica"},"Ein beschlagenes Gewächshaus auf dem Vulkan: riesige Kakteen, dampfende Aufwinde und Hecken, die nur Feuer-Zappilon wegbrennen; Gießkannen heilen, Samen werfen – und am Ende lauert die fleischfressende Blume „Schluckmops“.":{"en":"A foggy greenhouse on the volcano: giant cacti, steaming updrafts, and hedges that only Fire Zappilon can burn. Watering cans heal, seeds can be thrown. At the end lurks the flesh-eating flower, 'Gulp-Moss'.","es":"Un invernadero empañado en el volcán: cactus gigantes, corrientes de vapor que te elevan y setos que solo un Zappión de Fuego puede quemar. Los regaderas curan, las semillas se pueden lanzar. Al final acecha la flor carnívora, 'Traga-Lang'.","fr":"Une serre embuée sur le volcan : de grands cactus, des updrafts de vapeur qui vous soulèvent, et des haies que seul un Zappilon de Feu peut brûler. Les arroseuses soignent, les graines peuvent être lancées. À la fin, l'effroyable fleur 'Gob-Smousse' vous guette.","ja":"火山の上のしめった温室：巨大なサボテン、蒸気の上昇気流、そして「ファイヤーZappilon」だけが燃やせる生け垣。 watering cans が回復し、種は投げられます。最後には「スワロウモス」という肉食の花が待ち構えています。","pt":"Uma estufa embaçada no vulcão: cactos gigantes, correntes de vapor que te levam para cima e sebes que só um Zappilon de Fogo pode queimar. Regadores curam, sementes podem ser jogadas. No final, a flor carnívora 'Guloso' te espreita.","zh":"火山上的雾气弥漫的温室：巨大的仙人掌、蒸汽上升气流和只有火焰Zappilon才能点燃的树篱。洒水壶可以治疗，种子可以投掷。最终潜伏着食肉花“吞吞苔”。","it":"Una serra appannata sul vulcano: cactus giganti, sollevamenti di vapore e siepi che solo un Zappilon di Fuoco può bruciare. Gli annaffiatoi curano, i semi possono essere lanciati. All’ultima parte l’insidia è rappresentata dal fiore carnivoro ‘Sgranocchio’."},"Achtung: Dampf-Aufwind!":{"en":"Attention: Steam updraft!","es":"¡Atención: corriente de vapor!","fr":"Attention : souffle de vapeur !","ja":"注意：蒸気の上昇気流！","pt":"Atenção: corrente de vapor!","zh":"注意：蒸汽上升气流！","it":"Attenzione: sollevamento di vapore!"},"Boss-Bereich: Schluckmops":{"en":"Boss Area: Gulp-Moss","es":"Área de Jefe: Traga-Lang","fr":"Zone de Boss : Gob-Smousse","ja":"ボスエリア：スワロウモス","pt":"Área do Chefão: Guloso","zh":"Boss区域：吞吞苔","it":"Area Boss: Sgranocchio"},"Gewächshaus-Zugang":{"en":"Greenhouse Entrance","es":"Entrada al Invernadero","fr":"Entrée de la Serre","ja":"温室の入口","pt":"Entrada da Estufa","zh":"温室入口","it":"Ingresso Serra"},"Warnung: Lavapfützen!":{"en":"Warning: Lava Puddles!","es":"¡Advertencia: charcos de lava!","fr":"Avertissement : flaques de lave !","ja":"警告：溶岩の水たまり！","pt":"Atenção: poças de lava!","zh":"警告：熔岩水坑！","it":"Attenzione: pozzanghere di lava!"},"Heilung!":{"en":"Healed!","es":"¡Cura!","fr":"Soigné !","ja":"回復！","pt":"Cura!","zh":"治疗！","it":"Curato!"},"Kaktuswustler":{"en":"Kaktuswustler","es":"Kaktuswustler","fr":"Kaktuswustler","ja":"カクタスウストラー","pt":"Kaktuswustler","zh":"Kaktuswustler","it":"Kaktuswustler"},"Schluckmops":{"en":"Gulp-Moss","es":"Traga-Lang","fr":"Gob-Smousse","ja":"スワロウモス","pt":"Guloso","zh":"吞吞苔","it":"Sgranocchio"},"Gießkanne":{"en":"Watering Can","es":"Regadera","fr":"arrosoir","ja":" watering can","pt":"Regador","zh":"洒水壶","it":"annaffiatoio"},"Samen":{"en":"Seed","es":"Semilla","fr":"Graine","ja":"種","pt":"Semente","zh":"种子","it":"Seme"},"Stern":{"en":"Star","es":"Estrella","fr":"Étoile","ja":"星","pt":"Estrela","zh":"星星","it":"Stella"},"Hier oben wachsen die größten Kakteen der Welt!":{"en":"Here grow the world's largest cacti!","es":"¡Aquí crecen los cactus más grandes del mundo!","fr":"Ici poussent les cactus les plus grands du monde !","ja":"ここには世界最大級のサボテンが育っています！","pt":"Aqui crescem os cactos mais gigantescos do mundo!","zh":"这里生长着世界上最大的仙人掌！","it":"Qui crescono i cactus più giganteschi del mondo!"},"Die Gießkannen heilen – wirf Samen mit X!":{"en":"The watering cans heal – throw seeds with X!","es":"¡Las regaderas curan – lanza semillas con X!","fr":"Les arroseuses soignent – lance des graines avec X !","ja":" watering cans が回復します—Xで種を投げよう！","pt":"Os regadores curam – jogue sementes com X!","zh":"洒水壶能治疗——用X投掷种子！","it":"Gli annaffiatoi curano – lancia i semi con X!"},"Hecken blockieren den Weg – nur Feuer-Zappilon wegräumt sie!":{"en":"Hedges block the way – only Fire Zappilon clears them!","es":"¡Los setos bloquean el camino – solo un Zappión de Fuego los borra!","fr":"Les haies bloquent le chemin – seulement un Zappilon de Feu les détruit !","ja":"生け垣が道を塞いでいる—「ファイヤーZappilon」だけが取り除けます！","pt":"As sebes bloqueiam o caminho – só um Zappilon de Fogo as remove!","zh":"树篱阻挡了道路——只有火焰Zappilon能清除它们！","it":"Le siepi bloccano il percorso – solo uno Zappilon di Fuoco le rimuove!"},"Dampf-Aufwinde tragen dich hoch – aber sei vorsichtig!":{"en":"Steam updrafts lift you up – but be careful!","es":"¡Las corrientes de vapor te elevan – pero ten cuidado!","fr":"Les souffles de vapeur vous soulèvent – mais attention !","ja":"蒸気の上昇気流で上に上がって—but ご用心！","pt":"Correntes de vapor te levantam – mas cuidado!","zh":"蒸汽上升气流会把你托起——但要小心！","it":"I sollevamenti di vapore ti portano in alto – ma fai attenzione!"},"Ein gläsernes Vulkan-Gewächshaus mit Riesenkakteen, Kletterranken und Dampf-Aufwind. Feuer öffnet Heckenwege, Gießkannen heilen und eine Blume verwandelt sich im Bosskampf.":{"en":"A glassy volcanic greenhouse with giant cacti, climbing vines, and steam updrafts. Fire clears hedge paths, watering cans heal, and a flower transforms during the boss fight.","es":"Una invernadero volcánico de cristal con cactus gigantes, enredaderas trepadoras y corrientes de vapor ascendentes. El fuego abre caminos entre setos, las regaderas curan y una flor se transforma durante la pelea contra el jefe.","fr":"Une serre volcanique vitrée avec des cactus géants, des lianes grimpantes et des courants ascendants de vapeur. Le feu ouvre des sentiers à travers les haies, les arrosoirs soignent et une fleur se transforme lors du combat contre le boss.","ja":"巨大なサボテン、ツタの蔓、蒸気の上昇気流があるガラス張りの火山温室。火で hedge の道が開かれ、ジョウロで回復し、花がボス戦で変身する。","pt":"Uma estufa vulcânica de vidro com cactos gigantes, trepadeiras e correntes de vapor ascendentes. O fogo abre caminhos entre os viveiros, as regadeiras curam e uma flor se transforma durante a luta contra o chefe.","zh":"一座玻璃火山温室，内有巨型仙人掌、攀援藤蔓和蒸汽上升气流。火焰开辟树篱小径，喷壶可治疗，花朵在Boss战中会变身。","it":"Una serra vulcanica di vetro con cactus giganti, rampicanti e correnti ascensionali di vapore. Il fuoco apre sentieri tra le siepi, i annaffiatoi curano e un fiore si trasforma durante la battaglia contro il boss."},"Kletterranken und Dampf tragen dich zwischen die Riesenkakteen.":{"en":"Climbing vines and steam carry you between the giant cacti.","es":"Las enredaderas trepadoras y el vapor te llevan entre los cactus gigantes.","fr":"Les lianes grimpantes et la vapeur vous portent entre les cactus géants.","ja":"ツタの蔓と蒸気が、巨大なサボテンの間へとあなたを運んでくれます。","pt":"Trepadeiras e vapor te transportam entre os cactos gigantes.","zh":"攀援藤蔓与蒸汽将你托举至巨型仙人掌之间。","it":"Rampicanti e vapore ti trasportano tra i cactus giganti."},"Ein Feuer-Zappilon brennt Hecken weg: Fange Funki und wechsle mit T den Anführer.":{"en":"A Fire Zapillon burns away hedges: Catch Funki and switch the leader with T.","es":"Un Zapillón de fuego quema los setos: atrapa a Funki y cambia al líder con T.","fr":"Un Zapillon de feu brûle les haies : attrapez Funki et changez le chef avec T.","ja":"ファイヤーザピロンが hedge を燃やします：Funkiを捕まえて、Tキーでリーダーを交代。","pt":"Um Zapillon de Fogo queima os viveiros: pegue o Funki e troque o líder com T.","zh":"火焰 zapillon 焚烧树篱：捕捉 Funki 并用 T 键切换队长。","it":"Un Zapillon di fuoco brucia le siepi: cattura Funki e cambia il capo con T."},"Sammle Samen zum Werfen mit X. Gießkannen heilen dein Team.":{"en":"Collect seeds to throw with X. Watering cans heal your team.","es":"Recoge semillas para lanzarlas con X. Las regaderas curan a tu equipo.","fr":"Récoltez des graines à jeter avec X. Les arrosoirs soignent votre équipe.","ja":"Xキーで投げるための種を集めましょう。ジョウロでチームを回復。","pt":"Colete sementes para jogar com X. As regadeiras curam seu time.","zh":"收集种子，用 X 键投掷。喷壶可治疗你的队伍。","it":"Raccogli semi da lanciare con X. Gli annaffiatoi curano la tua squadra."},"Die Lavapfützen dampfen gefährlich; Schluckmops verwandelt sich im Bosskampf.":{"en":"Lava puddles steam dangerously; the Swallowmop transforms during the boss fight.","es":"Las charcas de lava hierven peligrosamente; el Tragamocos se transforma durante la pelea contra el jefe.","fr":"Les flaques de lave dégagent de la vapeur de façon dangereuse ; le Gloutomop se transforme lors du combat contre le boss.","ja":"溶岩の水たまりが危険な蒸気を上げます；スラロムップはボス戦で変身します。","pt":"As poças de lava fervem perigosamente; o Engolidor se transforma na luta contra o chefe.","zh":"熔岩水洼危险地冒着蒸汽；吞吞兽在Boss战中会变身。","it":"Le pozze di lava emettono vapore pericolosamente; il Glottomop si trasforma durante la battaglia contro il boss."},"Schluckmops, die Gewächshausblume":{"en":"Swallowmop, the greenhouse flower","es":"Tragamocos, la flor del invernadero","fr":"Gloutomop, la fleur de serre","ja":"スラロムップ、温室の花","pt":"Engolidor, a flor da estufa","zh":"吞吞兽，温室之花","it":"Glottomop, il fiore della serra"},"Die Blume öffnet sich im Kampf. Gießkannen heilen dein Team.":{"en":"The flower opens during battle. Watering cans heal your team.","es":"La flor se abre en combate. Las regaderas curan a tu equipo.","fr":"La fleur s'ouvre au combat. Les arrosoirs soignent votre équipe.","ja":"戦闘中に花が開きます。ジョウロでチームを回復。","pt":"A flor se abre na batalha. As regadeiras curam seu time.","zh":"花朵在战斗中绽放。喷壶可治疗你的队伍。","it":"Il fiore si apre in combattimento. Gli annaffiatoi curano la tua squadra."},"Schluckmops blüht auf und wird zu Blütenmops!":{"en":"Swallowmop blooms and transforms into Bloomtop!","es":"¡Tragamocos florece y se transforma en Floremocos!","fr":"Gloutomop fleurit et se transforme en Fleurimop !","ja":"スラロムップが咲いて、ブロウムップに変身！","pt":"Engolidor floresce e se transforma em Florimop!","zh":"吞吞兽绽放花朵，变身成花花兽！","it":"Glottomop fiorisce e si trasforma in Fiordomop!"},"Blütenmops":{"en":"Bloomtop","es":"Floremocos","fr":"Fleurimop","ja":"ブロウムップ","pt":"Florimop","zh":"花花兽","it":"Fiordomop"}}}
