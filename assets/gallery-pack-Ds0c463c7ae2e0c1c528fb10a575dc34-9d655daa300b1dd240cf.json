:27,"rx":16,"ry":17,"fill":"#b89360","stroke":"#6a5038"},{"shape":"circle","x":31,"y":13,"r":11,"fill":"#d7bc86","stroke":"#6a5038"},{"shape":"poly","points":[[39,12],[47,17],[39,20]],"fill":"#e4b34d"},{"shape":"circle","x":34,"y":11,"r":2,"fill":"#27394b"},{"shape":"ellipse","x":16,"y":28,"rx":10,"ry":7,"rot":-0.3,"fill":"#876348"},{"shape":"circle","x":27,"y":29,"r":8,"fill":"#f8edc7","stroke":"#6a5038"},{"shape":"line","points":[[27,24],[27,29],[31,31]],"width":1,"stroke":"#6a5038"},{"shape":"line","points":[[17,42],[16,47],[12,47]],"width":2,"stroke":"#6a5038"},{"shape":"line","points":[[29,42],[30,47],[34,47]],"width":2,"stroke":"#6a5038"}]}}}},"i18n":{"Zahnräder Turmuhr":{"en":"Gear Tower Clock","es":"Reloj de torre de engranajes","fr":"Horloge à engrenages de la tour","ja":"歯車の時計塔","pt":"Relógio de torre com engrenagens","zh":"齿轮钟楼","it":"Orologio a torre con ingranaggi"},"Steige durch das Uhrwerk: Zahnräder drehen sich, Pendel schwingen und Feuerzeiger kreisen. Schiebe Kisten auf Druckplatten, sammle Rädchen und finde den Kuckucks-Boss.":{"en":"Climb through the clockwork: gears spin, pendulums swing, and fire hands rotate. Push crates onto pressure plates, collect gears, and find the cuckoo boss.","es":"Sube por el mecanismo: los engranajes giran, los péndulos oscilan y las manecillas de fuego giran. Empuja cajas sobre placas de presión, recoge engranajes y encuentra al jefe cuco.","fr":"Monte à travers le mécanisme : les engrenages tournent, les pendules oscillent et les aiguilles de feu tournent. Poussez des caisses sur des plaques de pression, collectez des rouages et trouvez le boss coucou.","ja":"時計仕掛けを登ろう：歯車が回転し、振り子が揺れ、炎の針が回転します。圧力板の上に箱を押し込み、歯車を集め、カッコウのボスを見つけましょう。","pt":"Suba pelo mecanismo: engrenagens giram, pêndulos oscilam e ponteiros de fogo giram. Empurre caixas sobre placas de pressão, colete engrenagens e encontre o chefe cuco.","zh":"攀爬钟表内部：齿轮旋转，摆锤摆动，火焰指针旋转。将箱子推到压力板上，收集齿轮，找到杜鹃Boss。","it":"Climba attraverso il meccanismo: gli ingranaggi girano, i pendoli oscillano e le lancette di fuoco ruotano. Spingi le casse su piastre a pressione, raccogli gli ingranaggi e trova il boss cucù."},"Steige im Inneren der Turmuhr nach oben. Zahnräder tragen dich, Pendel schwingen wie Seile.":{"en":"Climb upward inside the tower clock. Gears support you, pendulums swing like ropes.","es":"Sube hacia arriba en el interior del reloj de torre. Los engranajes te sostienen, los péndulos oscilan como cuerdas.","fr":"Montez vers le haut à l’intérieur de l’horloge de la tour. Les engrenages vous soutiennent, les pendules oscillent comme des cordes.","ja":"時計塔の内部を上へ登りましょう。歯車があなたを支え、振り子がロープのように揺れます。","pt":"Suba para cima no interior do relógio de torre. As engrenagens o sustentam, os pêndulos oscilam como cordas.","zh":"在钟楼内部向上攀爬。齿轮托起你，摆锤如绳索般摆动。","it":"Climba verso l’alto all’interno dell’orologio a torre. Gli ingranaggi ti sostengono, i pendoli oscillano come corde."},"Die Feuerzeiger kreisen! Oben öffnen Kisten auf Druckplatten kleine Bonus-Tore.":{"en":"The fire hands rotate! At the top, crates on pressure plates open small bonus gates.","es":"¡Las manecillas de fuego giran! Arriba, las cajas sobre placas de presión abren pequeñas puertas de bonificación.","fr":"Les aiguilles de feu tournent ! En haut, les caisses sur les plaques de pression ouvrent de petites portes bonus.","ja":"炎の針が回転します！上部では、圧力板の上の箱が小さなボーナスゲートを開きます。","pt":"Os ponteiros de fogo giram! No topo, caixas sobre placas de pressão abrem pequenos portões bônus.","zh":"火焰指针旋转！顶部的压力板上的箱子会打开小型奖励门。","it":"Le lancette di fuoco ruotano! In cima, le casse sulle piastre a pressione aprono piccole porte bonus."},"Sammle Zahnrädchen und achte auf Stachelfallen im Takt. Ganz oben wartet Tickuck.":{"en":"Collect gears and watch out for spike traps in rhythm. Tickuck awaits at the very top.","es":"Recoge engranajes y ten cuidado con las trampas de pinchos al ritmo. Tickuck te espera en la cima.","fr":"Collectez les rouages et attention aux pièges à pointes au rythme. Tickuck vous attend tout en haut.","ja":"歯車を集めながら、リズムに合わせて棘の罠に注意してください。最上部でTickuckが待っています。","pt":"Colete engrenagens e fique atento às armadilhas de espinhos em ritmo. Tickuck o aguarda no topo.","zh":"收集齿轮，注意节奏中的尖刺陷阱。最顶端等待着Tickuck。","it":"Raccogli gli ingranaggi e attento alle trappole a spillo in ritmo. Tickuck ti aspetta in cima."},"Sammle 6 Zahnrädchen im Uhrwerk!":{"en":"Collect 6 gears in the clockwork!","es":"¡Recoge 6 engranajes en el mecanismo!","fr":"Collectez 6 rouages dans le mécanisme !","ja":"時計仕掛けで歯車を6つ集めましょう！","pt":"Colete 6 engrenagens no mecanismo!","zh":"在钟表内部收集6个齿轮！","it":"Raccogli 6 ingranaggi nel meccanismo!"},"Tickuck, der Kuckucks-Wächter":{"en":"Tickuck, the Cuckoo Guardian","es":"Tickuck, el guardián cuco","fr":"Tickuck, le gardien coucou","ja":"カッコウの守り人・Tickuck","pt":"Tickuck, o Guardião Cuco","zh":"Tickuck，杜鹃守护者","it":"Tickuck, il Guardiano Cucù"},"Tick-tack! Der Kuckuck bewacht den Ausgang der Turmuhr.":{"en":"Tick-tack! The cuckoo guards the exit of the tower clock.","es":"¡Tick-tack! El cuco guarda la salida del reloj de torre.","fr":"Tick-tack ! Le coucou garde la sortie de l’horloge de la tour.","ja":"チクタク！カッコウが時計塔の出口を守っています。","pt":"Tic-tac! O cuco guarda a saída do relógio de torre.","zh":"滴答！杜鹃守护着钟楼的出口。","it":"Tic-tac! Il cucù protegge l’uscita dell’orologio a torre."},"Tickuck":{"en":"Tickuck","es":"Tickuck","fr":"Tickuck","ja":"Tickuck","pt":"Tickuck","zh":"Tickuck","it":"Tickuck"},"Zahnrädchen":{"en":"Gears","es":"Engranajes","fr":"Rouages","ja":"歯車","pt":"Engrenagens","zh":"齿轮","it":"Ingranaggi"}}}
